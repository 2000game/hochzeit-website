---
import Base from '../../layouts/Base.astro';
import FormEnd from '../../components/FormEnd.astro';
import Kontakt from '../../components/Kontakt.astro';
import { PROGRAMM_API_URL } from '../../data/config';
---
<Base title="Programmpunkt">
  <h1>Programmpunkt anmelden</h1>
  <p>Du möchtest bei der Feier eine Rede halten, ein Spiel machen, etwas singen oder eine Diashow zeigen? Wie schön! Damit alles in den Ablauf passt, stimmen unsere Trauzeugen die Beiträge ab. Wir als Brautpaar sehen Deine Anmeldung nicht, die Überraschung bleibt also eine.</p>
  {!PROGRAMM_API_URL && <p class="inactive-note">Dieses Formular ist noch nicht aktiv. Melde Dich bis dahin direkt bei unseren Trauzeugen.</p>}
  <form id="pp-form" data-action="programmpunkt">
    <label for="pp-name">Dein Name</label>
    <input id="pp-name" type="text" name="name" maxlength="80" required />
    <label for="pp-kontakt">Telefon oder E-Mail (für Rückfragen)</label>
    <input id="pp-kontakt" type="text" name="kontakt" maxlength="200" required />
    <label for="pp-art">Art des Beitrags</label>
    <select id="pp-art" name="art" required>
      <option>Rede</option><option>Spiel</option><option>Musik / Lied</option><option>Video / Diashow</option><option>Sonstiges</option>
    </select>
    <label for="pp-beschreibung">Worum geht es? (kurz)</label>
    <textarea id="pp-beschreibung" name="beschreibung" maxlength="1000" rows="4" required></textarea>
    <label for="pp-dauer">Ungefähre Dauer in Minuten</label>
    <input id="pp-dauer" type="number" name="dauer" min="1" max="60" />
    <label for="pp-technik">Was brauchst Du? (z. B. Mikrofon, Beamer, Musikanlage)</label>
    <input id="pp-technik" type="text" name="technik" maxlength="200" />
    <FormEnd label="Anmelden" />
  </form>
  <Kontakt />
  <script>
    import { PROGRAMM_API_URL } from '../../data/config';
    import { setupForm } from '../../scripts/forms';
    setupForm(document.getElementById('pp-form') as HTMLFormElement, undefined, PROGRAMM_API_URL);
  </script>
</Base>
