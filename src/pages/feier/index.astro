---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { ablaufFeier, feier, bilder, texte } from '../../data/hochzeit';
---
<Base title="Feier">
  <h1>Die Feier</h1>
  <img class="hero" src={bilder.feier} alt="Platzhalterbild" width="1200" height="700" />
  <p>{texte.feier}</p>
  <h2>Ablauf</h2>
  <Timeline items={ablaufFeier} />
  <h2>Ort</h2>
  <p>{feier.name}<br />{feier.adresse}<br />Ende: {feier.ende}</p>
  {feier.mapsUrl && <p><a href={feier.mapsUrl}>Auf der Karte ansehen</a></p>}
  <p><a class="button" href="/feier/zusage/">Zur Zusage für die Feier</a></p>
</Base>
