---
import Base from '../../layouts/Base.astro';
import { trauung, feier, texte } from '../../data/hochzeit';
---
<Base title="Anreise">
  <h1>Anreise &amp; Parken</h1>
  <h2>Trauung &amp; Sektempfang</h2>
  <p>{trauung.name}<br />{trauung.adresse}</p>
  {trauung.mapsUrl && <p><a href={trauung.mapsUrl}>Karte</a></p>}
  <p>{trauung.parken}</p>
  <h2>ÖPNV</h2>
  <p>{trauung.oepnv}</p>
  <h2>Für Feier-Gäste: Die Feier-Location</h2>
  <p>{feier.name}<br />{feier.adresse}</p>
  {feier.mapsUrl && <p><a href={feier.mapsUrl}>Karte</a></p>}
  <p>{feier.fahrzeit} Wir organisieren keinen Shuttle. Bitte bildet Fahrgemeinschaften.</p>
  <p>{feier.parken}</p>
  <h2>Übernachtung</h2>
  <p>Wir kümmern uns nicht um Hotels. {texte.uebernachtung}</p>
</Base>
