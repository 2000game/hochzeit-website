---
import Base from '../../layouts/Base.astro';
import Timeline from '../../components/Timeline.astro';
import { ablaufTrauung, trauung, texte } from '../../data/hochzeit';
---
<Base title="Ablauf">
  <h1>Ablauf</h1>
  <p>{texte.ablauf}</p>
  <p>Ort: {trauung.name}, {trauung.adresse}</p>
  <Timeline items={ablaufTrauung} />
</Base>
