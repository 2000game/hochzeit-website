---
import '../styles/global.css';
import { paar } from '../data/hochzeit';
interface Props { title: string }
const { title } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Start' },
  { href: '/ablauf/', label: 'Trauung' },
  { href: '/feier/', label: 'Feier' },
  { href: '/programmpunkt/', label: 'Programmpunkt' },
  { href: '/zusage/', label: 'Zusage' },
  { href: '/bring-and-share/', label: 'Bring & Share' },
  { href: '/anreise/', label: 'Anreise' },
  { href: '/geschenke/', label: 'Geschenke' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/fotos/', label: 'Fotos' },
];
const fullTitle = title === 'Start' ? `${paar.name1} & ${paar.name2}` : `${title} – ${paar.name1} & ${paar.name2}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/">{paar.name1} & {paar.name2}</a>
        <nav aria-label="Hauptnavigation">
          <ul>
            {nav.map((n) => <li><a href={n.href} aria-current={path === n.href ? 'page' : undefined}>{n.label}</a></li>)}
          </ul>
        </nav>
      </div>
    </header>
    <main class="wrap"><slot /></main>
    <footer class="site">
      <div class="wrap"><a href="/impressum/">Impressum &amp; Datenschutz</a></div>
    </footer>
  </body>
</html>
